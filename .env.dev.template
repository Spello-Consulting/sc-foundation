# sc-foundation-services development environment variables
APP_ENV=development

# STMP credentials
SMTP_ENABLE=true

# SMTP_SERVER="op://Dev/Gmail SMTP/SMTPServer"
# SMTP_PORT="op://Dev/Gmail SMTP/SMTPPort"
# SMTP_USERNAME="op://Dev/Gmail SMTP/username"
# SMTP_PASSWORD="op://Dev/Gmail SMTP/password"
# SMTP_FROM_EMAIL="op://Dev/Gmail SMTP/FromEmail"
# SMTP_SEND_TO_EMAIL="op://Dev/Gmail SMTP/SendTo"

SMTP_SERVER="op://Dev/SafeShare SMTP Dev/SMTPServer"
SMTP_PORT="op://Dev/SafeShare SMTP Dev/SMTPPort"
SMTP_USERNAME="op://Dev/SafeShare SMTP Dev/username"
SMTP_PASSWORD="op://Dev/SafeShare SMTP Dev/password"
SMTP_FROM_EMAIL="op://Dev/SafeShare SMTP Dev/FromEmail"
SMTP_SEND_TO_EMAIL="op://Dev/SafeShare SMTP Dev/DefaultSendTo"



SMTP_SUBJECT_PREFIX="[sc-foundation-services Dev]: "

# Twilio for SMS (API Key auth)
# TWILIO_ACCOUNT_SID must be your ACCOUNT SID (starts with "AC"), found on the
# Twilio Console dashboard — NOT the API key SID. Paste it below.
TWILIO_ACCOUNT_SID=op://Dev/Twillo/AccountSID
TWILIO_API_KEY_SID=op://Dev/Twillo/APIKeySID
TWILIO_API_KEY_SECRET=op://Dev/Twillo/APIKeySecret

# Alphanumeric sender IDs must be <= 11 chars (letters/digits/spaces).
TWILIO_FROM_NUMBER=SCFound

# Numberic receipient IDs - must be valid IDD format numbers. If specified, this overrides
# the SMS.SendSMSTo key in the configuration file.
TWILIO_SEND_SMS_TO=op://Dev/SMSAlertNumbers/Italy